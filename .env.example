DATABASE_URL="postgresql://user:password@localhost:5432/dbname?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"

# Resend email (transactional emails: verification, password reset)
# Get your API key at https://resend.com/api-keys
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="onboarding@resend.dev"

# PDF rendering: set these to use the external Docker PDF renderer service.
# When PDF_RENDERER_URL is set, the Vercel API route proxies PDF generation
# to this external service with bearer auth.
# When unset, the local in-process Playwright renderer is used (development).
PDF_RENDERER_URL=""
PDF_RENDERER_TOKEN=""

# Stripe billing (optional in dev, required in production)
STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Price IDs from Stripe Dashboard → Products → [Product] → API ID
# The price metadata does not need "plan" — the webhook maps price ID to plan directly.
STRIPE_PROFESSIONAL_PRICE_ID="price_xxx"
STRIPE_ENTERPRISE_PRICE_ID="price_yyy"

# Webhook secret from Stripe Dashboard → Developers → Webhooks → [endpoint]
# Required for checkout.session.completed + customer.subscription.* events to sync the DB.
# For local dev, use `stripe listen --forward-to localhost:3000/api/billing/webhook`
# and set STRIPE_WEBHOOK_SECRET to the "whsec_..." secret stripe CLI prints.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Billing grace period (default: 3 days)
PAST_DUE_GRACE_DAYS=3

# Base URL for Stripe redirect URLs (default: http://localhost:3000)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# AI Providers (optional in dev, required for real AI features)
# Set AI_DEFAULT_PROVIDER to "gemini", "groq", or "mock" (default: mock)
AI_DEFAULT_PROVIDER="mock"
# Google AI Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=""

