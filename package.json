{
    "name": "careerlaunch-studio",
    "version": "0.1.0",
    "private": true,
    "description": "Original resume, CV, and cover-letter builder SaaS.",
    "scripts": {
        "dev": "npm run dev --workspace @careerlaunch/web",
        "build": "npm run build --workspaces --if-present",
        "deploy": "node scripts/deploy.js",
        "postinstall": "prisma generate",
        "lint": "npm run lint --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "eval": "tsx scripts/eval/run.ts",
        "eval:dogfooding": "tsx scripts/eval/dogfooding/dogfood-runner.ts",
        "eval:benchmark": "tsx scripts/eval/dogfooding/dogfood-runner.ts --json"
    },
    "workspaces": [
        "apps/*",
        "packages/*",
        "services/*"
    ],
    "engines": {
        "node": ">=20"
    },
    "overrides": {
        "postcss": "^8.5.10"
    }
}
