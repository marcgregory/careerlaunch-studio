generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  passwordHash  String
  passwordSalt  String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  resumes       ResumeDocument[]
  coverLetters  CoverLetter[]
  subscriptions Subscription[]
}

model ResumeDocument {
  id           String          @id @default(cuid())
  userId       String
  title        String
  targetRole   String?
  body         Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  exports      ExportJob[]
  analysisRuns AnalysisRun[]
  coverLetters CoverLetter[]

  @@index([userId, updatedAt])
}

model ResumeVersion {
  id        String         @id @default(cuid())
  resumeId  String
  body      Json
  note      String?
  createdAt DateTime       @default(now())
  resume    ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

model AnalysisRun {
  id              String         @id @default(cuid())
  resumeId        String
  resumeVersionId String?
  type            String // "full" | dimension name
  provider        String // e.g. "static", "mock-v1", "gpt-4o"
  promptVersion   String?
  durationMs      Int            @default(0)
  overallScore    Float?
  suggestionCount Int            @default(0)
  createdAt       DateTime       @default(now())
  resume          ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
  @@index([resumeId, type])
}

model ExportJob {
  id        String         @id @default(cuid())
  resumeId  String
  format    ExportFormat
  status    ExportStatus   @default(PENDING)
  fileUrl   String?
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  resume    ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

model CoverLetter {
  id             String         @id @default(cuid())
  userId         String
  resumeId       String
  title          String         @default("Cover Letter")
  recipientName  String?
  recipientTitle String?
  companyName    String?
  companyAddress String?
  salutation     String         @default("Dear Hiring Manager,")
  body           String         @default("")
  closing        String         @default("Sincerely,")
  signatureName  String?
  jobDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([resumeId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  plan                 Plan               @default(FREE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(FREE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

enum ExportFormat {
  PDF
  DOCX
  TXT
}

enum ExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum Plan {
  FREE
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}
