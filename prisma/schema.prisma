generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  passwordHash     String
  passwordSalt     String
  emailVerifiedAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  resumes          ResumeDocument[]
  coverLetters     CoverLetter[]
  subscriptions    Subscription[]
  authTokens       AuthToken[]
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  type      String    // "email_verification" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type])
  @@index([expiresAt])
}

model ResumeDocument {
  id           String          @id @default(cuid())
  userId       String
  title        String
  targetRole   String?
  body         Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  exports      ExportJob[]
  analysisRuns AnalysisRun[]
  coverLetters CoverLetter[]

  @@index([userId, updatedAt])
}

model ResumeVersion {
  id        String         @id @default(cuid())
  resumeId  String
  body      Json
  note      String?
  createdAt DateTime       @default(now())
  resume    ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

model AnalysisRun {
  id              String         @id @default(cuid())
  resumeId        String
  resumeVersionId String?
  type            String // "full" | dimension name
  provider        String // e.g. "static", "mock-v1", "gpt-4o"
  promptVersion   String?
  durationMs      Int            @default(0)
  overallScore    Float?
  suggestionCount Int            @default(0)
  viewedCount     Int            @default(0)
  acceptedCount   Int            @default(0)
  appliedCount    Int            @default(0)
  rejectedCount   Int            @default(0)
  createdAt       DateTime       @default(now())
  resume          ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
  @@index([resumeId, type])
}

model ExportJob {
  id        String         @id @default(cuid())
  resumeId  String
  format    ExportFormat
  status    ExportStatus   @default(PENDING)
  fileUrl   String?
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  resume    ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

model CoverLetter {
  id             String         @id @default(cuid())
  userId         String
  resumeId       String
  title          String         @default("Cover Letter")
  recipientName  String?
  recipientTitle String?
  companyName    String?
  companyAddress String?
  salutation     String         @default("Dear Hiring Manager,")
  body           String         @default("")
  closing        String         @default("Sincerely,")
  signatureName  String?
  jobDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([resumeId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  plan                 Plan               @default(FREE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(FREE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model ProcessedStripeEvent {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SuggestionFeedback {
  id            String   @id @default(cuid())
  suggestionId  String
  userId        String
  resumeId      String
  analysisRunId String?
  category      String
  helpful       Boolean
  reason        String?  // "too_generic" | "incorrect" | "invented" | "doesnt_match" | "other"
  reasonText    String?  // free text when reason is "other"
  provider      String?
  model         String?
  promptVersion String?
  createdAt     DateTime @default(now())

  @@index([resumeId])
  @@index([userId, createdAt])
}

model SuggestionEvent {
  id            String   @id @default(cuid())
  suggestionId  String
  userId        String
  resumeId      String
  analysisRunId String?
  action        String   // "viewed" | "accepted" | "rejected" | "applied"
  category      String
  createdAt     DateTime @default(now())

  @@index([analysisRunId])
  @@index([userId, createdAt])
}

enum ExportFormat {
  PDF
  DOCX
  TXT
}

enum ExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum Plan {
  FREE
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}
