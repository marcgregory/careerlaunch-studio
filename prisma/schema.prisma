generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  passwordHash    String
  passwordSalt    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  emailVerifiedAt DateTime?
  authTokens      AuthToken[]
  coverLetters    CoverLetter[]
  resumes         ResumeDocument[]
  subscriptions   Subscription?
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type])
  @@index([expiresAt])
}

model ResumeDocument {
  id              String          @id @default(cuid())
  userId          String
  title           String
  targetRole      String?
  body            Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  /// Client-generated UUID sent as Idempotency-Key header on POST /duplicate.
  /// Allows the server to return the already-created copy on retry instead of
  /// creating a second one. NULL for resumes not created via duplication.
  idempotencyKey  String?
  analysisRuns    AnalysisRun[]
  coverLetters    CoverLetter[]
  exports         ExportJob[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions        ResumeVersion[]

  @@index([userId, updatedAt])
  @@unique([userId, idempotencyKey])
}

model ResumeVersion {
  id        String         @id @default(cuid())
  resumeId  String
  body      Json
  note      String?
  createdAt DateTime       @default(now())
  resume    ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

model AnalysisRun {
  id              String         @id @default(cuid())
  resumeId        String
  resumeVersionId String?
  type            String
  provider        String
  promptVersion   String?
  durationMs      Int            @default(0)
  overallScore    Float?
  suggestionCount Int            @default(0)
  createdAt       DateTime       @default(now())
  acceptedCount   Int            @default(0)
  appliedCount    Int            @default(0)
  rejectedCount   Int            @default(0)
  viewedCount     Int            @default(0)
  resume          ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
  @@index([resumeId, type])
}

model ExportJob {
  id        String         @id @default(cuid())
  resumeId  String
  format    ExportFormat
  status    ExportStatus   @default(PENDING)
  fileUrl   String?
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  resume    ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

model CoverLetter {
  id             String         @id @default(cuid())
  userId         String
  resumeId       String
  title          String         @default("Cover Letter")
  recipientName  String?
  recipientTitle String?
  companyName    String?
  companyAddress String?
  salutation     String         @default("Dear Hiring Manager,")
  body           String         @default("")
  closing        String         @default("Sincerely,")
  signatureName  String?
  jobDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resume         ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([resumeId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(FREE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  plan                 Plan               @default(FREE)
  cancelAtPeriodEnd    Boolean            @default(false)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProcessedStripeEvent {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SuggestionFeedback {
  id            String   @id @default(cuid())
  suggestionId  String
  userId        String
  resumeId      String
  analysisRunId String?
  category      String
  helpful       Boolean
  reason        String?
  reasonText    String?
  provider      String?
  model         String?
  promptVersion String?
  createdAt     DateTime @default(now())

  @@index([resumeId])
  @@index([userId, createdAt])
}

model SuggestionEvent {
  id            String   @id @default(cuid())
  suggestionId  String
  userId        String
  resumeId      String
  analysisRunId String?
  action        String
  category      String
  createdAt     DateTime @default(now())

  @@index([analysisRunId])
  @@index([userId, createdAt])
}

enum ExportFormat {
  PDF
  DOCX
  TXT
}

enum ExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum Plan {
  FREE
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}
